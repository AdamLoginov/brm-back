[Unit]
Description=BRM backend
After=network.target

[Service]
User=brm
Group=brm
WorkingDirectory=/var/lib/brm
EnvironmentFile=/etc/brm.env
ExecStart=/opt/brm/current/brm
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/brm

[Install]
WantedBy=multi-user.target
