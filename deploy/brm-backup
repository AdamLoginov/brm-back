#!/bin/sh
set -eu
umask 077
destination="/var/backups/brm/$(date -u +%Y%m%d-%H%M%S)"
mkdir -p "$destination"
sqlite3 /var/lib/brm/test.db ".backup '$destination/test.db'"
tar -czf "$destination/uploads.tar.gz" -C /var/lib/brm uploads
# Keep seven days on this small server; off-server backups are still required.
find /var/backups/brm -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec rm -rf -- {} +
